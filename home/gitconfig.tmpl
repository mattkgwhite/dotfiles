[user]
  name = {{ vars.git_name }}
  email = {{ vars.git_email }}
[color]
  ui = true
[core]
  editor = nvim
  excludesfile = {{ env.HOME }}/.gitignore_global
[github]
  user = {{ vars.github_user }}
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[pull]
  rebase = false
[include]
  path = {{ env.HOME }}/.gitconfig.overrides
[init]
  defaultBranch = main
[url "ssh://git@github.com/"]
  pushInsteadOf = https://github.com/